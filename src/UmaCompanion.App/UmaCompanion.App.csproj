<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>UmaCompanion.App</RootNamespace>
    <!-- Lets the WSL/Linux side restore & compile the solution; the app still only RUNS on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UmaCompanion.Core\UmaCompanion.Core.csproj" />
  </ItemGroup>

</Project>
