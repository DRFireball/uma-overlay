<Window x:Class="UmaCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uma Companion — Missing Trophies" Height="640" Width="720"
        Background="#FF1B1D24" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE6E8EF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <!-- Flat tab; the selected one is painted by the view model (see MissingTabBackground). -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE6E8EF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Missing Trophy Schedule" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Status}" Foreground="#FF9AA3B2" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Stats strip -->
        <Grid Grid.Row="1" Margin="0,14,0,10">
        <StackPanel Orientation="Horizontal">
            <Border Background="#FF262A35" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="MISSING" FontSize="11" Foreground="#FF9AA3B2" />
                    <TextBlock Text="{Binding MissingCount}" FontSize="24" FontWeight="Bold" Foreground="#FFF2C14E" />
                </StackPanel>
            </Border>
            <Border Background="#FF262A35" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="WON" FontSize="11" Foreground="#FF9AA3B2" />
                    <TextBlock Text="{Binding WonCount}" FontSize="24" FontWeight="Bold" Foreground="#FF6FCF97" />
                </StackPanel>
            </Border>
            <Border Background="#FF262A35" CornerRadius="8" Padding="14,8">
                <StackPanel>
                    <TextBlock Text="TOTAL TROPHIES" FontSize="11" Foreground="#FF9AA3B2" />
                    <TextBlock Text="{Binding TotalTrophies}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </StackPanel>
        <Button Content="Reset wins" Click="OnResetWins"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Padding="12,6" Background="#FF3A2A2A" Foreground="#FFE6A0A0"
                BorderBrush="#FF5A3A3A" Cursor="Hand"
                ToolTip="Clear every recorded win (asks first). Re-browse the Trophy Room to re-sync." />
        </Grid>

        <!-- Tab bar: the two lists below share one cell, toggled by visibility -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="{Binding MissingTabLabel}" Click="OnShowMissing"
                    Style="{StaticResource TabButton}" Background="{Binding MissingTabBackground}" />
            <Button Content="{Binding WonTabLabel}" Click="OnShowWon"
                    Style="{StaticResource TabButton}" Background="{Binding WonTabBackground}" />
        </StackPanel>

        <!-- Missing schedule table -->
        <ListView Grid.Row="3" ItemsSource="{Binding Schedule}" Visibility="{Binding MissingListVisibility}"
                  Background="#FF20232C" BorderBrush="#FF31353F" Foreground="#FFE6E8EF">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Turn" Width="150" DisplayMemberBinding="{Binding Slot}" />
                    <GridViewColumn Header="Race" Width="290" DisplayMemberBinding="{Binding Race}" />
                    <GridViewColumn Header="Grade" Width="60" DisplayMemberBinding="{Binding Grade}" />
                    <GridViewColumn Header="Distance" Width="140" DisplayMemberBinding="{Binding Distance}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Won table -->
        <ListView Grid.Row="3" ItemsSource="{Binding Won}" Visibility="{Binding WonListVisibility}"
                  Background="#FF20232C" BorderBrush="#FF31353F" Foreground="#FFE6E8EF">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Race" Width="400" DisplayMemberBinding="{Binding Race}" />
                    <GridViewColumn Header="Grade" Width="80" DisplayMemberBinding="{Binding Grade}" />
                    <GridViewColumn Header="Race ID" Width="100" DisplayMemberBinding="{Binding RaceId}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding CaptureStatus}" Foreground="#FF9AA3B2" />
            <TextBlock Text="{Binding HookActivity}" Foreground="#FF9AA3B2" Margin="0,2,0,0" />
            <TextBlock Text="{Binding MasterDbPath}" Foreground="#FF6B7280" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</Window>
