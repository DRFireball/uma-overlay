<?xml version="1.0" encoding="utf-8"?>
<!--
  The shipping build: one self-contained UmaCompanion.exe with the .NET runtime inside it, so a
  user downloads a single file and double-clicks it. Nothing to install first.

  Invoked by publish.ps1 and by .github/workflows/release.yml — keep the settings here so both
  produce the identical artifact.

  Not trimmed: WPF is not trim-safe, and the app resolves WinRT types (Windows.Graphics.Capture,
  Windows.Media.Ocr) reflectively enough that trimming risks a runtime failure no test would catch.
  Compression brings the ~150 MB payload down to roughly half.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
